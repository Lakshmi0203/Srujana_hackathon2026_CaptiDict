
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id           String        @id @default(cuid())
  name         String        @db.VarChar(80)
  email        String        @unique @db.VarChar(254)
  passwordHash String
  role         UserRole      @default(USER)
  projects     Project[]
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(120)
  description String   @default("") @db.VarChar(2000)
  status      String   @default("active") @db.VarChar(30)
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId, updatedAt])
}

model Transaction {
  id                String   @id @default(cuid())
  title             String   @db.VarChar(200)
  type              String   @db.VarChar(20)
  amount            Float
  date              String   @db.VarChar(10)
  confidence        Float    @default(1)
  companyName       String?  @db.VarChar(120)
  userConfidence    Float?
  confidenceSource  String   @default("legacy") @db.VarChar(30)
  feedbackOutcome   String?  @db.VarChar(30)
  actualDate        String?  @db.VarChar(10)
  actualAmount      Float?
  status            String   @default("forecast") @db.VarChar(30)
  key               String?  @db.VarChar(100)
  delayCostPerWeek  Float?
  canDefer          Boolean  @default(false)
  ownerId           String
  owner             User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([ownerId, date])
  @@index([ownerId, companyName])
  @@index([ownerId, updatedAt])
}
